@* Revealed by date-picker.ts only after Cally is ready. The adjacent input is the form control. *@
<details hidden class="dropdown dropdown-start sm:dropdown-end">
    <summary class="btn btn-outline">Choose date</summary>
    <div class="dropdown-content z-20 mt-2 max-sm:-ml-6 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg">
        <calendar-date class="cally" aria-label="Calendar">
            <svg aria-label="Previous month" class="size-4 fill-current" slot="previous" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
            <svg aria-label="Next month" class="size-4 fill-current" slot="next" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
            <calendar-month></calendar-month>
        </calendar-date>
    </div>
</details>
